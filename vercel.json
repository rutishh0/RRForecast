{
  "functions": {
    "api/engine-data/[[...action]].ts": { "maxDuration": 30 },
    "api/auth/[...action].ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/engine-data", "destination": "/api/engine-data/_root" },
    { "source": "/api/dashboard", "destination": "/api/dashboard/_root" },
    { "source": "/api/messages", "destination": "/api/messages/_root" },
    { "source": "/api/postits", "destination": "/api/postits/_root" },
    { "source": "/api/feature-requests", "destination": "/api/feature-requests/_root" },
    { "source": "/api/users", "destination": "/api/users/_root" }
  ]
}
