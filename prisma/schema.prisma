generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMs
// ============================================================

enum UserRole {
  admin
  manager
  user
}

enum DashboardItemType {
  deadline
  todo
  action_item
  meeting
}

enum DashboardPriority {
  low
  medium
  high
  critical
}

enum DashboardStatus {
  pending
  in_progress
  completed
  overdue
}

enum PostitContext {
  engine
  engine_map
  shop_visit_forecast
  engine_forecast
  general
}

enum FeatureRequestStatus {
  submitted
  under_review
  in_progress
  completed
  declined
}

// ============================================================
// User
// ============================================================
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  role         UserRole  @default(user)
  email        String?
  jobTitle     String?   @map("job_title")
  avatarColor  String?   @map("avatar_color")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLogin    DateTime? @map("last_login") @db.Timestamptz

  dashboardItems  DashboardItem[]
  sentMessages    Message[]        @relation("Sender")
  recvdMessages   Message[]        @relation("Recipient")
  postitNotes     PostitNote[]
  postitReads     PostitRead[]
  featureRequests FeatureRequest[]

  @@map("users")
}

// ============================================================
// Dashboard items
// ============================================================
model DashboardItem {
  id                Int               @id @default(autoincrement())
  userId            Int               @map("user_id")
  itemType          DashboardItemType @map("item_type")
  title             String
  description       String?
  dueDate           DateTime?         @map("due_date") @db.Timestamptz
  priority          DashboardPriority @default(medium)
  status            DashboardStatus   @default(pending)
  relatedEsn        String?           @map("related_esn")
  relatedEngineType String?           @map("related_engine_type")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemType])
  @@index([dueDate])
  @@index([status])
  @@map("dashboard_items")
}

// ============================================================
// Messages
// ============================================================
model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int       @map("sender_id")
  recipientId Int       @map("recipient_id")
  subject     String?
  body        String
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  sender    User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================================
// Post-it notes + read tracking
// ============================================================
model PostitNote {
  id          Int           @id @default(autoincrement())
  authorId    Int           @map("author_id")
  contextType PostitContext @map("context_type")
  contextId   String?       @map("context_id")
  content     String
  color       String?       @default("#FBBF24")
  positionX   Float?        @map("position_x")
  positionY   Float?        @map("position_y")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads  PostitRead[]

  @@index([contextType, contextId])
  @@index([authorId])
  @@map("postit_notes")
}

model PostitRead {
  postitId Int      @map("postit_id")
  userId   Int      @map("user_id")
  readAt   DateTime @default(now()) @map("read_at") @db.Timestamptz

  postit PostitNote @relation(fields: [postitId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postitId, userId])
  @@map("postit_reads")
}

// ============================================================
// Feature requests
// ============================================================
model FeatureRequest {
  id          Int                  @id @default(autoincrement())
  requesterId Int                  @map("requester_id")
  title       String
  description String
  status      FeatureRequestStatus @default(submitted)
  adminNotes  String?              @map("admin_notes")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requesterId])
  @@map("feature_requests")
}

// ============================================================
// Shop visits (engine SV tracking)
// ============================================================
model ShopVisit {
  id Int @id @default(autoincrement())

  lessor         String?
  lessorCarePlus String? @map("lessor_care_plus")
  operator       String?
  esn            String?
  msn            String?
  aircraftType   String? @map("aircraft_type")
  registration   String?
  engineType     String? @map("engine_type")
  wingStatus     String? @map("wing_status")

  leaseExpiry           String? @map("lease_expiry")
  transitionDate        String? @map("transition_date")
  removalDate           String? @map("removal_date")
  transitionProbability Float?  @map("transition_probability")
  svProbability         Float?  @map("sv_probability")
  totalSvContribution   Float?  @map("total_sv_contribution")
  fcsRemaining          String? @map("fcs_remaining")
  amContact             String? @map("am_contact")

  inductionGate      String? @map("induction_gate")
  svType             String? @map("sv_type")
  svReason           String? @map("sv_reason")
  dateSvRequested    String? @map("date_sv_requested")
  requiredOutputDate String? @map("required_output_date")
  status             String?
  mfaOperatorRef     String? @map("mfa_operator_ref")
  mfaInductionDate   String? @map("mfa_induction_date")
  inductionStatus    String? @map("induction_status")
  shop               String?
  offlogStatus       String? @map("offlog_status")
  workscopeAgreed    String? @map("workscope_agreed")
  plannedToTest      String? @map("planned_to_test")
  plannedToArc       String? @map("planned_to_arc")
  riskToCustomer     String? @map("risk_to_customer")

  contractInPlace String? @map("contract_in_place")
  contractType    String? @map("contract_type")
  contractRef     String? @map("contract_ref")

  fullyFunded       String? @map("fully_funded")
  paymentTerms      String? @map("payment_terms")
  mfaInductionDate2 String? @map("mfa_induction_date_2")
  poRequested       String? @map("po_requested")
  customerPoRef     String? @map("customer_po_ref")
  networkPaying     String? @map("network_paying")
  networkInMfa      String? @map("network_in_mfa")

  svPrice            String? @map("sv_price")
  profit             String?
  cashOutEligible    String? @map("cash_out_eligible")
  cashOutProbability Float?  @map("cash_out_probability")

  crcsApplicable      String? @map("crcs_applicable")
  backingDataReceived String? @map("backing_data_received")
  backingDataSent     String? @map("backing_data_sent")
  invoicePayment      String? @map("invoice_payment")
  customerMaster      String? @map("customer_master")
  addressForCrc       String? @map("address_for_crc")
  crcContact          String? @map("crc_contact")
  comments            String?

  taskOwner   String? @map("task_owner")
  priority    String?
  openActions String? @map("open_actions")
  lastUpdated String? @map("last_updated")
  nextSteps   String? @map("next_steps")

  rowIndex   Int?     @map("row_index")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([esn])
  @@index([engineType])
  @@index([lessor])
  @@index([operator])
  @@map("shop_visits")
}

// ============================================================
// Forecasts
// ============================================================
model Forecast {
  id              Int     @id @default(autoincrement())
  lessor          String?
  lessorCarePlus  String? @map("lessor_care_plus")
  operator        String?
  esn             String?
  engineType      String? @map("engine_type")
  wingStatus      String? @map("wing_status")
  removalDate     String? @map("removal_date")
  comment         String?
  svTypeNeeded    String? @map("sv_type_needed")
  svPrice         String? @map("sv_price")
  cashOutEligible String? @map("cash_out_eligible")
  profitMillion   String? @map("profit_million")
  priority        String?
  notes           String?

  rowIndex   Int?     @map("row_index")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([esn])
  @@index([engineType])
  @@map("forecasts")
}
